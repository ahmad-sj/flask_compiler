lexer grammar pythonLexer;



// Condition
    IF  :    'if';
    ELIF :   'elif'; //اختصار ل else if
    ELSE : 'else';

     // loops

     FOR     : 'for';
     WHILE   : 'while';
    BREAK   : 'break';
    CONTINUE: 'continue';

     //Definition
    DEF     : 'def';


    // OOP
    CLASS   : 'class';
    RETURN  : 'return';
    IMPORT  : 'import';



